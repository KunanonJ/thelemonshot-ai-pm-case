{
  "name": "lemon-shot-suite",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:demo:local": "wrangler d1 execute DB --local --file seed/demo-creators.sql",
    "db:seed:demo:remote": "wrangler d1 execute DB --remote --file seed/demo-creators.sql"
  },
  "dependencies": {
    "@clerk/backend": "3.26.5",
    "@clerk/react": "6.18.4",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "pptxgenjs": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "pptxgenjs@4.0.1>image-size": "2.0.4",
      "@esbuild-kit/core-utils@3.3.2>esbuild": "0.25.12"
    }
  }
}
