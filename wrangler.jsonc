{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lemon-shot-suite",
	"account_id": "187ab61ed9dbc6e616cb23e6b95aa8f1",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Served only at the custom domain; the account's workers.dev subdomain stays off
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "lemonshot.kunanonj.com",
			"custom_domain": true
		}
	],
	"assets": {
		"not_found_handling": "single-page-application",
		// API, health and public config reach the Worker first; every other path is the React app
		"run_worker_first": [
			"/api/*",
			"/health",
			"/config",
			"/r/*",
			"/store",
			"/store/*"
		]
	},
	"observability": {
		"enabled": true
	},
	// Workers AI runs the default model (core/llm.ts); 10,000 Neurons a day are free on every plan
	"ai": {
		"binding": "AI"
	},
	// Every 5 minutes during Phase 0 so the checks run as soon as secrets land; Phase 1 sets the real schedules
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lemon-shot-suite",
			"database_id": "ccf1d3f1-5301-49ac-937b-0591d93e7e70",
			"migrations_dir": "drizzle"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CONFIG",
			"id": "41e6c553290d4ca0896dc296fc4293b1"
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "lemon-shot-suite-files",
			"binding": "FILES"
		}
	],
	// Enrichment runs out of band (PRD §6.3); messages that fail 3 times land in the dead-letter queue
	"queues": {
		"producers": [
			{
				"binding": "ENRICH_QUEUE",
				"queue": "lemon-shot-enrich"
			}
		],
		"consumers": [
			{
				"queue": "lemon-shot-enrich",
				"max_batch_size": 5,
				"max_retries": 3,
				"dead_letter_queue": "lemon-shot-enrich-dlq"
			}
		]
	}
}