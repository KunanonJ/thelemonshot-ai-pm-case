{
  "name": "OPS-01 Error handler (alert + dead letter)",
  "nodes": [
    {
      "parameters": {
        "content": "## OPS-01 · Error handler\nSet as the **Error workflow** in CM-01 settings.\nClassify → alert #ai-ops → dead-letter table. A scheduled job retries transient failures with backoff (5 min, 30 min, 2 h; max 3), then opens a ticket for a human.",
        "height": 560,
        "width": 1000,
        "color": 3
      },
      "id": "5b09f3b8-86b5-408d-9146-ee74286bff8a",
      "name": "Note: OPS-01",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -40
      ]
    },
    {
      "parameters": {},
      "id": "ce4c9ff3-2359-4144-8f22-a7cdfc4e67f3",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Classify the failure so ops knows whether to wait, retry, or fix a token\nconst e = $input.first().json;\nconst msg = e.execution?.error?.message ?? '';\nconst status = Number((msg.match(/\\b(4\\d\\d|5\\d\\d)\\b/) || [])[1]) || null;\nconst retryable = [408, 429, 500, 502, 503, 504, 529].includes(status) || /timeout|ETIMEDOUT|ECONNRESET/i.test(msg);\nconst category = (status === 401 || status === 403 || /code 190|access token/i.test(msg)) ? 'auth: reconnect needed'\n  : retryable ? 'transient: will retry' : 'permanent: needs a human';\nreturn [{ json: {\n  workflow: e.workflow?.name, node: e.execution?.lastNodeExecuted, message: msg, http_status: status,\n  category, retryable, execution_url: e.execution?.url, retry_count: 0,\n  next_retry_at: retryable ? new Date(Date.now() + 5 * 60 * 1000).toISOString() : null,\n} }];"
      },
      "id": "1e41f5e5-ae2a-4e8b-a2df-800e275576a8",
      "name": "Classify error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "text": "=:rotating_light: {{ $json.workflow }} failed at *{{ $json.node }}*\n{{ $json.message }}\nCategory: {{ $json.category }} · {{ $json.execution_url }}",
        "otherOptions": {}
      },
      "id": "4d0a47ca-921f-4e28-a882-6edd35fe6146",
      "name": "Slack: alert #ai-ops",
